{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scribe",
  "version": "0.1.1",
  "identifier": "com.stratusadv.scribe",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "scribe",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 540,
        "maximized": true,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0b0b0b"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/com.stratusadv.scribe/jobs/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNjkwQThFOTBFQjBCNUUKUldSZUMrdVFqZ3Bwa0FrQUhqSWU3YjVUTk5ya1JWU2pyUHhQR0JUb252MDlHdTZkUjBKWlNaMWoK",
      "endpoints": [
        "https://github.com/stratusadv/scribe/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
